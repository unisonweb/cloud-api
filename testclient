    curl_command "${SEND_BINARY[@]}" -d "$1" "$(url "/v2/deployments/create?environmentId=$2")"
}

deploy_delete() {
    curl_command -X DELETE "$(url "/v2/deployments/$1")"
}

deploy_get() {
    curl_command "${ACCEPT_JSON[@]}" "$(url "/v2/deployments/$1")" | jq '[.]' | deploy_format
}

