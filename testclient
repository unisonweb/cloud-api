command() {
    if [ $# -lt 1 ]; then
        command_help
        return
    else
        section=$1 ; shift
        case $section in
          account)
                account_command "$@"
                ;;
            e | env | environment | environments)
                environment_command "$@"
                ;;
            sn | sname | serviceName)
                serviceName_command "$@"
                ;;
            si | sid | serviceId)
                serviceId_command "$@"
                ;;
            store | storage)
                storage_command "$@"
                ;;
            d | deployment | deployments | deploy)
                deploy_command "$@"
                ;;

            daemon)
                daemon_command "$@"
                ;;
            
            l | log | logs)
                log_command "$@"
                ;;
            o | opt | option | options)
                options_command "$@"
                ;;
            q | exit | quit)
                cleanup
                exit 0
                ;;
            help)
                command_help "$@"
                ;;
            *)
                echo "Unknown section: $section"
                ;;
        esac
    fi
}

command_help() {
    if [ $# -gt 0 ]; then
        case $1 in
          account)
                account_help
                ;;
            e | env | environment | environments)
                environment_help
                ;;
            serviceId | sid | si)
                serviceId_help
                ;;
            serviceName | sname | sn)
                serviceName_help
                ;;
            store | storage)
                storage_help
                ;;
            d | deployment | deployments | deploy)
                deployment_help
                ;;
            l | log | logs)
                logs_help
                ;;
            o | opt | option | options)
                options_help
                ;;
            q | exit | quit)
                ;;
            *)
                echo "Unknown section: $1"
                ;;
        esac
    else

    echo "Possible Commands: "
    echo "  [section] [command]"
    echo "  help"
    echo "  quit | exit | q"
    echo
    echo "Sections:"
    echo "  options      | option      | opt    | o"
    echo "  environments | environment | env    | e"
    echo "  serviceIds   | sids        | si"
    echo "  serviceNames | snames      | sn"
    echo "  deployment   | deployments | deploy | d"
    echo "  storage      | store"
    echo "  logs         | log         | l"
    echo
    echo "For more help, type:"
    echo "  [section] help"
    echo
    echo " e.g.:"
    echo " > env help"
    echo
    fi
}

repl() {
    while true; do
        # shellcheck disable=SC2162
        if ! read -e -p "> " line; then 
            cleanup
            exit 0
        fi
        command $line
        history -s "$line"
        history -w "$HISTORY_FILE"
        echo
    done
}

