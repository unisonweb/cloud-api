usage() {
    echo "Usage: $0 [-hvq] section command"
    echo "Options:"
    echo "  -h  Show this help"
    echo "  -v  Verbose output"
    echo "  -q  Less output"
    echo "  -s  Use staging server"
    echo "  -p  Use production server"
}

parseOptions() {
    while getopts "hqvps" opt; do
        case $opt in
            h)
                usage
                exit 0
                ;;
            q)
                VERBOSITY=0
                ;;
            v)
                VERBOSITY=2
                ;;
            p)
                LOCAL=0
	    	;;
	    s)
                LOCAL=0
		STAGING=1
                ;;
            \?)
                echo "Invalid option _$OPTARG" >&2
                exit 1
                ;;
        esac
    done
}

cleanup() {
    rm "${COOKIE_JAR}"
}

die() {
    if [ $# -gt 0 ]; then
        red "$1\n"
    fi
    cleanup
    exit 1
}

trap 'cleanup; red "Unknown failure\n"' HUP INT QUIT PIPE TERM

if [ "$VERBOSITY" -gt 1 ]; then set -x ; fi

echo 'enter "help" for help'
echo

parseOptions "$@"

if [ "$LOCAL" -eq 1 ]; then
    curl_login
fi


HISTORY_FILE="$HOME/.cloudrepl_history"
touch "$HISTORY_FILE"
history -r "$HISTORY_FILE"

repl
