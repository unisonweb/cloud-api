generate_hash() {
    echo -n "$1" | openssl dgst -sha256 -binary | base64 | tr '/' '_' | tr '+' '-' | tr -d '='
}

RED='\033[0;31m'
GREEN='\033[0;32m'
LIGHT_GRAY='\033[0;90m'
PLAIN='\033[0m'

red() {
    # shellcheck disable=SC2059
    printf "${RED}$*${PLAIN}\n"
}

green() {
    # shellcheck disable=SC2059
    printf "${GREEN}$*${PLAIN}\n"
}

gray() {
    # shellcheck disable=SC2059
    printf "${LIGHT_GRAY}$1${PLAIN}\n"
}

