    curl_command -X POST "$(url "/v2/deployments/$1/tag/$2")"
}

deployd_untag() {
    curl_command -X DELETE "$(url "/v2/deployments/$1/tag/$2")"
}

deploy_list_untagged() {
    curl_command "$(url "/v2/deployments/untagged")"
}

deploy_command() {
    if [ $# -lt 1 ]; then
        deployment_help
    else
        command=$1 ; shift
        case $command in
            get)
                deploy_get "$@"
                ;;
            create)
                deploy_create "$@"
                ;;
            delete | del | d)
                deploy_delete "$@"
                ;;  
            expose)
                deploy_expose "$@"
                ;;
            unexpose)
                deploy_unexpose "$@"
                ;;
            list | ls)
                deploy_list
                ;;
