#!/bin/sh

# This file sets the necessary environment variables to make ucm and the cloud client point to our BYOC staging environment.
#
# Example usage (using a subshell to avoid polluting the current shell):
#
# (set -a; . ./byoc-staging.env && ucm)
# .> switch nimbus
# nimbus/main> io.test integrationTests.withCloudClient

export UNISON_SHARE_HOST=https://staging.api.unison-lang.org
export UNISON_CLOUD_HOST=beyonce.staging-byoc.unison.cloud
export UNISON_CLOUD_CREDENTIALS_HOST=staging.api.unison-lang.org
export UNISON_CLOUD_TCP_PORT=29163
